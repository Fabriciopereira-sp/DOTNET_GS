{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "voz-e-via-java",
    "Audience": "voz-e-via",
    "ExpiracaoMinutos": 60
  },
  "Auth": {
    "HabilitarTokenDeTeste": false
  },
  "RateLimit": {
    "RequisicoesPorMinuto": 60,
    "ReportesPorMinuto": 5
  },
  "Uploads": {
    "Pasta": "uploads"
  },
  "ServicosExternos": {
    "ApiJavaHealthUrl": ""
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=caminholivre.db",
    "Oracle": ""
  }
}
